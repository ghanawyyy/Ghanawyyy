# Copy to .env.local and fill in. All optional for local dev.

# HMAC secret for session cookies — REQUIRED in production.
SESSION_SECRET=

# Base URL used in password-reset links.
APP_URL=http://localhost:3000

# Where the JSON datastore lives (default ./.data)
DATA_DIR=

# SMTP for real reset emails (otherwise links are logged to the console).
# Requires: npm i nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Enables the email-exposure breach check.
HIBP_API_KEY=
